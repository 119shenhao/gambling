{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gambling-community-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/",
      "/index.html",
      "/topic/*",
      "/search",
      "/me",
      "/notifications",
      "/admin",
      "/privacy",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemaps/*"
    ]
  },
  "vars": {
    "APP_ENV": "local",
    "IMPORT_ENABLED": "false",
    "COLLECT_ENABLED": "false",
    "IDENTITY_LOGIN_ENABLED": "false",
    "PUBLIC_CONTENT_ENABLED": "false",
    "PUBLIC_CONTENT_READS": "false",
    "PUBLIC_CONTENT_FALLBACK": "false",
    "TRANSLATION_ENABLED": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gambling-community-local",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations/v1"
    }
  ]
}
