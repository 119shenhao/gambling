{
  "name": "gambling-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "tsc --noEmit",
    "test": "node --test tests/gambling.test.mjs tests/sync-behavior.test.mjs tests/r2-cache-contract.test.mjs tests/sync-cdn-acceptance.test.mjs",
    "verify": "npm run check && npm test",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "build": "node scripts/prepare-build.mjs",
    "sync:production": "node scripts/sync-preview-to-production.mjs",
    "repair:preview-language": "node scripts/repair-preview-language-proofs.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "tinyld": "1.3.4"
  }
}
